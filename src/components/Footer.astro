---
// Footer — driven by site data. Socials render only when they exist:
// no fake links. LinkedIn appears automatically once its URL is added
// to src/data/site.ts.
import Container from "./Container.astro";
import { site } from "../data/site";

const year = new Date().getFullYear();
const socials = [
  { label: "GitHub", href: site.github },
  ...(site.linkedin ? [{ label: "LinkedIn", href: site.linkedin }] : []),
];
---

<footer class="border-t border-line">
  <Container>
    <div
      class="flex flex-col items-center justify-between gap-4 py-8 sm:flex-row"
    >
      <p class="text-sm text-faint">
        &copy; {year} Ghouse Nahri — built with Astro.
      </p>
      <ul class="flex items-center gap-4">
        {
          socials.map(({ label, href }) => (
            <li>
              <a
                href={href}
                {...(href.startsWith("http")
                  ? { target: "_blank", rel: "noopener noreferrer" }
                  : {})}
                class="text-sm font-medium text-muted transition-colors duration-150 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</footer>
