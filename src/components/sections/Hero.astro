---
// Hero — the first thing visitors see: who I am, in one glance.
// All text comes from src/data/site.ts (real content only).
import Container from "../Container.astro";
import Section from "../Section.astro";
import Button from "../Button.astro";
import Badge from "../Badge.astro";
import { site } from "../../data/site";

// Hidden admin door: the trigger lives on the DOT zone of the final "i"
// in the name ("Nahri"). Only the dot area is interactive — the letter,
// the word and the design are visually untouched. If the name is ever
// changed in the admin and no longer ends with "i", the trigger simply
// doesn't render (no broken UI, no mis-positioned target).
const name = site.name;
const hasDotTrigger = name.endsWith("i");
const nameBase = hasDotTrigger ? name.slice(0, -1) : name;
---

<Section space="md" class="pt-16 sm:pt-28">
  <Container>
    <div class="max-w-2xl">
      <!-- Availability badge: recruiters learn the page's purpose immediately -->
      <Badge class="mb-6 border-accent/40 text-accent">
        <span class="mr-1.5 inline-block size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        {site.availability}
      </Badge>

      <!-- The page's single h1 -->
      <h1>
        {hasDotTrigger ? (
          <>
            {nameBase}
            {/* word-joiner: the i-span is an atomic inline, so without this
                a narrow line could break between "Nahr" and "i" */}
            &#8288;
            <span class="idot-wrap">
              {name.slice(-1)}
              <!-- aria-hidden: the letter itself stays in the a11y tree;
                   only the invisible click target is hidden. -->
              <span class="idot-target" data-admin-dot aria-hidden="true"></span>
            </span>
          </>
        ) : (
          name
        )}
        <!-- Role gets its own smaller scale: display size makes this
             line wrap into a huge 2-line block on phones. -->
        <span class="mt-2 block text-xl text-muted sm:text-2xl">{site.role}</span>
      </h1>

      <p class="mt-5 max-w-prose text-lg text-muted">{site.tagline}</p>

      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="#projects" variant="primary" size="lg">
          View projects
        </Button>
        <Button
          href={site.github}
          variant="secondary"
          size="lg"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub&nbsp;↗
        </Button>
      </div>
    </div>
  </Container>
</Section>
