---
// Badge — small pill label for tags, tech names, statuses.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center rounded-full border border-line bg-elevated px-3 py-1 font-mono text-xs text-muted",
    className,
  ]}
>
  <slot />
</span>
