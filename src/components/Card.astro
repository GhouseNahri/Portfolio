---
// Card — the reusable surface for Projects / Skills / anywhere.
// As a real link it lifts on hover; as a plain container it stays quiet.
//
// Motion discipline: transitions are limited to border-color, box-shadow
// and transform (the only properties that change) — no `transition-all`.
// Duration/easing come from the global defaults set in global.css
// (Phase 3 tokens: 150ms, ease-out-soft), so nothing is hardcoded here.
interface Props {
  href?: string;
  class?: string;
}
const { href, class: className } = Astro.props;
---

{
  href ? (
    <a
      href={href}
      class:list={[
        "group block rounded-lg border border-line bg-surface p-6 shadow-soft",
        "transition-[border-color,box-shadow,transform] ease-out-soft duration-base",
        "hover:-translate-y-0.5 hover:border-accent/60 hover:shadow-lift",
        "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
        className,
      ]}
    >
      <slot />
    </a>
  ) : (
    <div
      class:list={[
        "rounded-lg border border-line bg-surface p-6 shadow-soft",
        className,
      ]}
    >
      <slot />
    </div>
  )
}
