---
// Container — keeps content centered at a consistent max width.
// Every page section sits inside one of these, so horizontal
// margins are identical everywhere.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={["mx-auto w-full max-w-5xl px-5 sm:px-8", className]}>
  <slot />
</div>
