---
// Section — a vertical chunk of the page with consistent rhythm.
// Props: id (for nav anchors) and spacing size. Rendered as a real
// <section> landmark so assistive tech can navigate the page.
//
// `scroll-mt-24`: when a nav link jumps to #id, this keeps the section
// heading 6rem below the top — clear of the 64px (4rem) sticky header.
//
// `reveal`: opt-in scroll reveal — wraps the section's inner content in a
// single [data-reveal] wrapper so a whole section fades in as one unit
// (subtle by design; individual elements are never animated separately).
interface Props {
  id?: string;
  space?: "md" | "lg";
  reveal?: boolean;
  class?: string;
}
const { id, space = "lg", reveal = false, class: className } = Astro.props;
---

<section
  id={id}
  class:list={[
    space === "lg" ? "py-20 sm:py-28" : "py-12 sm:py-16",
    id && "scroll-mt-24",
    className,
  ]}
>
  {reveal ? <div data-reveal> <slot /> </div> : <slot />}
</section>
