---
// SHOWCASE — temporary page proving the design system works.
// Delete or keep for dev reference at the end of Phase 4.
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import Badge from "../components/Badge.astro";

const palette = [
  { token: "background", className: "bg-background", note: "page background" },
  { token: "surface", className: "bg-surface", note: "cards / panels" },
  { token: "elevated", className: "bg-elevated", note: "raised elements" },
  { token: "ink", className: "bg-ink", note: "primary text" },
  { token: "muted", className: "bg-muted", note: "secondary text" },
  { token: "faint", className: "bg-faint", note: "captions / meta" },
  { token: "line", className: "bg-line", note: "borders" },
  { token: "accent", className: "bg-accent", note: "brand teal" },
  { token: "accent-hover", className: "bg-accent-hover", note: "accent hover" },
  { token: "success", className: "bg-success", note: "success" },
  { token: "warning", className: "bg-warning", note: "warning" },
  { token: "error", className: "bg-error", note: "error" },
];
---

<BaseLayout title="Design System Showcase" description="Temporary internal page for verifying the design system.">
  <Container>
    <Section space="md" class="pt-10 sm:pt-14">
      <p class="font-mono text-xs uppercase tracking-widest text-accent">
        Temporary dev page
      </p>
      <h1>Design System Showcase</h1>
      <p class="mt-3 max-w-prose text-muted">
        Every element below uses the shared tokens. Try the theme toggle
        (top right) and resize the window — nothing should break between
        320px and 1440px+.
      </p>
    </Section>

    <!-- Typography -->
    <Section space="md">
      <h2>Typography</h2>
      <div class="mt-6 space-y-4">
        <h1>H1 — Space Grotesk, fluid clamp()</h1>
        <h2>H2 — section headings</h2>
        <h3>H3 — card titles</h3>
        <h4>H4 — small headings</h4>
        <p>
          Body text in Inter at 1rem/1.7. The quick brown fox jumps over the
          lazy dog while deliberately wrapping across a couple of lines to
          show the readable measure.
        </p>
        <p class="text-sm text-muted">Small muted text for supporting notes.</p>
        <p class="font-mono text-xs text-faint">JetBrains Mono caption — v1.0 · build passed</p>
      </div>
    </Section>

    <!-- Colors -->
    <Section space="md">
      <h2>Color tokens</h2>
      <ul class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {
          palette.map(({ token, className, note }) => (
            <li>
              <div class={`${className} h-14 rounded-md border border-line`} />
              <p class="mt-1.5 font-mono text-xs text-ink">{token}</p>
              <p class="text-xs text-faint">{note}</p>
            </li>
          ))
        }
      </ul>
    </Section>

    <!-- Buttons & links -->
    <Section space="md">
      <h2>Buttons &amp; links</h2>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <Button href="#buttons" variant="primary">Primary link</Button>
        <Button href="#buttons" variant="secondary">Secondary link</Button>
        <Button href="#buttons" variant="ghost">Ghost link</Button>
        <Button variant="primary">Button (action)</Button>
        <Button variant="secondary" disabled>Disabled</Button>
      </div>
      <p class="mt-6 max-w-prose text-muted">
        Inline link styles: read the
        <a class="underline decoration-accent/60 decoration-2 underline-offset-4 transition-colors duration-150 hover:decoration-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href="#buttons">styled inline link</a>
        or an
        <a class="underline decoration-accent/60 decoration-2 underline-offset-4 transition-colors duration-150 hover:decoration-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href="https://astro.build" target="_blank" rel="noopener noreferrer">external link (new tab)</a>.
      </p>
    </Section>

    <!-- Cards, badges, nav -->
    <Section space="md">
      <h2>Cards, badges &amp; navigation</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <Card href="#showcase">
          <h3 class="font-display text-lg">Linked card</h3>
          <p class="mt-2 text-sm text-muted">
            Whole card is a link — lifts on hover, keyboard focusable.
          </p>
          <span class="mt-4 inline-block text-sm font-medium text-accent">
            View →
          </span>
        </Card>
        <Card>
          <h3 class="font-display text-lg">Static card</h3>
          <p class="mt-2 text-sm text-muted">
            A plain container for content that is not itself a link.
          </p>
        </Card>
        <Card>
          <h3 class="font-display text-lg">With badges</h3>
          <p class="mt-2 text-sm text-muted">Badges as future tech tags:</p>
          <div class="mt-3 flex flex-wrap gap-2">
            <Badge>python</Badge>
            <Badge>astro</Badge>
            <Badge>tailwind</Badge>
          </div>
        </Card>
      </div>
    </Section>

    <!-- Theme behavior note -->
    <Section space="md" class="pb-20">
      <h2>Theme &amp; accessibility checks</h2>
      <Card class="mt-6">
        <ul class="list-inside list-disc space-y-2 text-muted">
          <li>Toggle the theme: every token above should flip, with no flash.</li>
          <li>
            Press <kbd class="rounded border border-line bg-elevated px-1.5 py-0.5 font-mono text-xs">Tab</kbd>
            from the top: a skip link appears first, then the focus ring is
            visible on every control.
          </li>
          <li>Header links smooth-scroll to page anchors; Escape closes the mobile menu.</li>
          <li>Resize to 320px: no horizontal scrollbars anywhere.</li>
        </ul>
      </Card>
    </Section>
  </Container>
</BaseLayout>
