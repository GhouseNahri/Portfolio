---
// BaseLayout — the shared skeleton for every page.
// A page supplies <title> and (optionally) description + content slots;
// this component handles fonts, tokens, theme, header, footer, a11y.
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site, education } from "../data/site";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  // Default meta description — editable in the local admin
  // (src/data/site.ts → site.seo.description).
  description = site.seo.description,
} = Astro.props;

// Canonical URL + og:url come from `site` in astro.config.mjs (the real
// production URL, set at deployment).
const canonical = Astro.site?.href;

// Social preview image: root-relative works on any host; becomes absolute
// automatically once `site` is configured (same upgrade path as canonical).
const ogImage = canonical ? new URL("/og-image.png", canonical).href : "/og-image.png";

// Structured data (JSON-LD): verified Phase 7 facts only — no invented
// credentials, ratings or URLs. Data-driven from site.ts.
const edu = education.entries[0];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: site.role,
  description,
  sameAs: [site.github, site.linkedin].filter(Boolean),
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: edu.institution,
  },
  ...(canonical ? { url: canonical } : {}),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <!-- Single theme-color meta: the inline init script below sets it
         to match the effective theme BEFORE first paint, and the toggle
         keeps it in sync — phone browser chrome always matches. -->
    <meta name="theme-color" content="#0b1015" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>

    <!--
      Open Graph / Twitter: built from the page's real title + description
      (Phase 7 content). `summary` card needs no image, so shared links
      show honest text instead of a fake placeholder image.
    -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}

    <!-- Structured data — see frontmatter note. -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!--
      Theme init: runs before first paint so the page never flashes the
      wrong theme. Kept tiny and inline on purpose (performance rule:
      no extra JS file, no framework).
    -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const prefersLight = matchMedia(
            "(prefers-color-scheme: light)"
          ).matches;
          const theme = stored ?? (prefersLight ? "light" : "dark");
          document.documentElement.classList.toggle("light", theme === "light");
          // Phone browser chrome matches the theme from the first frame.
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute(
              "content",
              theme === "light" ? "#f5f8f8" : "#0b1015"
            );
        } catch {
          /* private browsing: default to dark */
        }
        // JS flag for scroll-reveal (see global.css): reveal styles only
        // apply when JS has loaded, so content never gets stuck hidden.
        document.documentElement.classList.add("js");
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />

    <!--
      Scroll-reveal: a <script> tag (NOT a frontmatter import) is what makes
      Astro bundle this for the BROWSER. Frontmatter imports execute during
      server rendering, where `document` doesn't exist — that broke the build.
    -->
    <script>
      import "../scripts/reveal";
    </script>
  </body>
</html>

<style>
  /* Sticky footer: short pages still push the footer to the bottom.
     `100svh` is the small-viewport height unit — on phones, plain `100vh`
     is taller than the visible screen (address bar), which made the footer
     jump when the bar collapsed. svh fixes that; vh stays as fallback
     for older browsers. */
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
  }
</style>
